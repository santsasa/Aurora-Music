# Cambiá estos datos antes de iniciar.
APP_USER=admin
APP_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA
APP_PORT=8787
# Optional LAN URL that Chromecast devices can reach; inferred from the browser URL when blank.
CAST_STREAM_BASE_URL=
# Carpeta local o punto de montaje NAS; ruta absoluta recomendada.
MUSIC_PATH=./music
PUID=1000
PGID=1000

# Letras en línea (LRCLIB); false impide consultas a Internet.
LYRICS_ONLINE_ENABLED=true
# User-Agent identificable para LRCLIB; indicá la URL del repo propio si lo publicás.
LYRICS_USER_AGENT=AuroraMusic/0.3.1 (+https://github.com/santsasa/Aurora-Music)

# Listado de radios online (Radio Browser); requiere Internet para consultar.
RADIO_ENABLED=true
RADIO_USER_AGENT=AuroraMusic/0.3.1 (self-hosted radio directory)
